<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>JM Servicios Integrales — Gestión PRO v2</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<style>
:root{--negro:#0d0d0d;--gris-oscuro:#171717;--gris-medio:#242424;--gris-borde:#333;--gris-claro:#3d3d3d;--amarillo:#f0c040;--amarillo-hover:#f7d66b;--verde:#4caf7d;--rojo:#e35d5d;--azul:#5da5e8;--blanco:#f3f0e8;--muted:#969696;--radio:14px;--shadow:0 10px 30px rgba(0,0,0,.28)}
*{box-sizing:border-box;margin:0;padding:0}html{font-size:16px}body{background:linear-gradient(180deg,#0d0d0d,#141414);color:var(--blanco);font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;min-height:100vh;overflow-x:hidden}.brand-font{font-family:Impact,Haettenschweiler,'Arial Narrow Bold',sans-serif;letter-spacing:1.5px}nav{background:rgba(23,23,23,.97);backdrop-filter:blur(10px);border-bottom:1px solid var(--gris-borde);padding:0 12px;display:flex;align-items:center;position:sticky;top:0;z-index:100;overflow-x:auto;scrollbar-width:none}nav::-webkit-scrollbar{display:none}.nav-brand{font-size:1.45rem;color:var(--amarillo);white-space:nowrap;padding-right:14px;margin-right:4px;line-height:56px}.nav-btn{background:none;border:0;color:var(--muted);font-weight:800;font-size:.72rem;text-transform:uppercase;letter-spacing:.8px;padding:0 11px;height:56px;cursor:pointer;white-space:nowrap;border-bottom:2px solid transparent}.nav-btn.active,.nav-btn:hover{color:var(--amarillo);border-bottom-color:var(--amarillo)}.section{display:none;padding:18px 14px 90px;max-width:760px;margin:0 auto}.section.active{display:block}.card{background:rgba(23,23,23,.97);border:1px solid var(--gris-borde);border-radius:var(--radio);padding:16px;margin-bottom:14px;box-shadow:var(--shadow)}.card-title{font-size:1rem;font-weight:900;letter-spacing:1px;color:var(--amarillo);margin-bottom:12px;text-transform:uppercase}.help{font-size:.82rem;color:var(--muted);line-height:1.35;margin-bottom:12px}.stats-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px}.stat-card{background:var(--gris-medio);border:1px solid var(--gris-borde);border-radius:var(--radio);padding:14px;text-align:center}.stat-value{font-size:1.55rem;font-weight:950;color:var(--amarillo);letter-spacing:.5px}.stat-label{font-size:.68rem;color:var(--muted);text-transform:uppercase;letter-spacing:.8px;margin-top:2px}.verde{color:var(--verde)!important}.rojo{color:var(--rojo)!important}.azul{color:var(--azul)!important}.campo{margin-bottom:12px}.campo label{display:block;font-size:.72rem;color:var(--muted);text-transform:uppercase;letter-spacing:.8px;margin-bottom:5px;font-weight:800}.campo input,.campo select,.campo textarea{width:100%;background:var(--gris-medio);border:1px solid var(--gris-borde);border-radius:10px;color:var(--blanco);font:inherit;font-size:.95rem;padding:11px 12px;outline:none}.campo textarea{min-height:78px;resize:vertical}.campo input:focus,.campo select:focus,.campo textarea:focus{border-color:var(--amarillo)}.fila2{display:grid;grid-template-columns:1fr 1fr;gap:10px}.fila3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}.btn{background:var(--amarillo);color:#111;border:0;border-radius:10px;font-weight:950;text-transform:uppercase;letter-spacing:1px;padding:12px 16px;cursor:pointer;width:100%;font-size:.9rem}.btn:hover{background:var(--amarillo-hover)}.btn:active{transform:scale(.985)}.btn-sm{width:auto;padding:8px 12px;font-size:.76rem}.btn-danger{background:var(--rojo);color:white}.btn-ok{background:var(--verde);color:#06140c}.btn-ghost{background:transparent;border:1px solid var(--gris-borde);color:var(--blanco)}.btn-ghost:hover{border-color:var(--amarillo);color:var(--amarillo);background:transparent}.btn-wa{background:#25D366;color:#fff;border:0;border-radius:10px;font-weight:950;padding:12px 16px;cursor:pointer;width:100%;font-size:.9rem;letter-spacing:.5px}.btn-wa:hover{background:#1ebe58}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.item-row{display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-bottom:1px solid var(--gris-borde);gap:10px}.item-row:last-child{border-bottom:0}.item-info{flex:1;min-width:0}.item-title{font-weight:900;font-size:.92rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.item-sub{font-size:.76rem;color:var(--muted);margin-top:3px}.item-amount{font-weight:950;font-size:1.05rem;white-space:nowrap}.badge{display:inline-flex;align-items:center;gap:3px;padding:3px 8px;border-radius:999px;font-size:.64rem;font-weight:950;text-transform:uppercase;letter-spacing:.4px;border:0}.badge-verde{background:rgba(76,175,125,.14);color:var(--verde)}.badge-rojo{background:rgba(227,93,93,.14);color:var(--rojo)}.badge-amarillo{background:rgba(240,192,64,.14);color:var(--amarillo)}.badge-azul{background:rgba(93,165,232,.14);color:var(--azul)}.sep{height:1px;background:var(--gris-borde);margin:14px 0}.total-row{display:flex;justify-content:space-between;gap:10px;padding:7px 0;font-size:.9rem}.total-row .label{color:var(--muted)}.total-row.grande{font-size:1.25rem;font-weight:950;color:var(--amarillo)}.margen-bar{background:var(--gris-medio);border-radius:6px;height:7px;overflow:hidden;margin-top:8px}.margen-fill{height:100%;background:var(--amarillo);border-radius:6px;transition:.4s}.tab-group{display:flex;gap:6px;margin-bottom:14px;overflow-x:auto}.tab-pill{background:var(--gris-medio);border:1px solid var(--gris-borde);border-radius:999px;color:var(--muted);font-size:.72rem;font-weight:900;padding:7px 13px;cursor:pointer;white-space:nowrap}.tab-pill.active{background:var(--amarillo);color:#111;border-color:var(--amarillo)}.empty{text-align:center;padding:34px 14px;color:var(--muted)}.empty-icon{font-size:2.3rem;margin-bottom:8px}.modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.82);z-index:200;align-items:flex-end;justify-content:center}.modal-overlay.open{display:flex}.modal{background:var(--gris-oscuro);border:1px solid var(--gris-borde);border-radius:18px 18px 0 0;padding:18px 14px 26px;width:100%;max-width:620px;max-height:92vh;overflow-y:auto}.modal-title{font-size:1.15rem;font-weight:950;color:var(--amarillo);margin-bottom:14px;text-transform:uppercase;letter-spacing:1px}.modal-close{float:right;background:none;border:0;color:var(--muted);font-size:1.25rem;cursor:pointer}.precio-ref-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.precio-ref-item{background:var(--gris-medio);border:1px solid var(--gris-borde);border-radius:12px;padding:10px;cursor:pointer}.precio-ref-item:hover{border-color:var(--amarillo)}.precio-ref-item .nombre{font-size:.76rem;font-weight:900;margin-bottom:4px}.precio-ref-item .rango{font-weight:950;color:var(--amarillo)}.precio-ref-item .unit{font-size:.65rem;color:var(--muted)}.partida-row{display:grid;grid-template-columns:1.15fr .65fr .65fr 30px;gap:7px;align-items:center;margin-bottom:8px}.partida-row input,.partida-row select{background:var(--gris-medio);border:1px solid var(--gris-borde);border-radius:9px;color:var(--blanco);padding:9px;font-size:.82rem;width:100%}.search{margin-bottom:10px}.pill-note{padding:10px 12px;border-radius:12px;background:rgba(240,192,64,.08);border:1px solid rgba(240,192,64,.2);font-size:.82rem;color:#e8dcb8;line-height:1.35}.print-area{display:none}

/* Logo upload area */
.logo-upload-area{border:2px dashed var(--gris-borde);border-radius:12px;padding:16px;text-align:center;cursor:pointer;transition:.2s}.logo-upload-area:hover{border-color:var(--amarillo)}.logo-preview{max-height:70px;max-width:200px;object-fit:contain;border-radius:8px}.num-badge{background:rgba(93,165,232,.15);border:1px solid rgba(93,165,232,.3);color:var(--azul);border-radius:999px;padding:2px 8px;font-size:.68rem;font-weight:950;letter-spacing:.5px}

/* WhatsApp action card */
.wa-action{background:rgba(37,211,102,.07);border:1px solid rgba(37,211,102,.25);border-radius:14px;padding:13px;margin-top:10px}

@media(min-width:650px){.section{padding:24px 18px 70px}.stats-grid{grid-template-columns:repeat(4,1fr)}.modal{border-radius:18px}.modal-overlay{align-items:center}}@media(max-width:430px){.partida-row{grid-template-columns:1fr 70px 70px 28px}.fila3{grid-template-columns:1fr}.grid3{grid-template-columns:1fr}.nav-btn{padding:0 9px}.stat-value{font-size:1.25rem}}@media print{body{background:white;color:#111}.no-print,nav,.section,.modal-overlay{display:none!important}.print-area{display:block}.print-doc{padding:28px;font-family:Arial,sans-serif}.print-doc h1{font-size:24px;margin-bottom:4px}.print-doc h2{font-size:18px;margin:18px 0 8px}.print-doc table{width:100%;border-collapse:collapse;margin-top:12px}.print-doc th,.print-doc td{border:1px solid #ddd;padding:8px;text-align:left}.print-doc th{background:#f2f2f2}.print-doc .right{text-align:right}.print-doc .total{font-weight:bold;font-size:18px}.print-doc .small{font-size:12px;color:#555}.print-doc .box{border:1px solid #ddd;padding:10px;margin:10px 0}}

.floating-add{position:fixed;right:16px;bottom:18px;z-index:90;width:56px;height:56px;border-radius:50%;box-shadow:0 12px 35px rgba(0,0,0,.45);font-size:1.6rem;padding:0;display:flex;align-items:center;justify-content:center}.toolbar{display:flex;gap:8px;align-items:center;justify-content:space-between;margin-bottom:12px;flex-wrap:wrap}.toolbar .search{flex:1;min-width:190px;margin-bottom:0}.select-inline{background:var(--gris-medio);border:1px solid var(--gris-borde);border-radius:999px;color:var(--blanco);padding:8px 10px;font-size:.78rem;font-weight:800}.mini-actions{display:flex;gap:6px;flex-wrap:wrap;margin-top:9px}.mini-btn{border:1px solid var(--gris-borde);background:rgba(255,255,255,.03);color:var(--blanco);border-radius:999px;padding:7px 10px;font-size:.68rem;font-weight:950;text-transform:uppercase;letter-spacing:.35px;cursor:pointer}.mini-btn:hover{border-color:var(--amarillo);color:var(--amarillo)}.mini-btn.ok{background:rgba(76,175,125,.16);border-color:rgba(76,175,125,.35);color:var(--verde)}.mini-btn.warn{background:rgba(240,192,64,.12);border-color:rgba(240,192,64,.28);color:var(--amarillo)}.mini-btn.danger{background:rgba(227,93,93,.12);border-color:rgba(227,93,93,.28);color:var(--rojo)}.mini-btn.wa{background:rgba(37,211,102,.14);border-color:rgba(37,211,102,.35);color:#25D366}.pres-card{background:linear-gradient(180deg,rgba(36,36,36,.85),rgba(23,23,23,.95));border:1px solid var(--gris-borde);border-radius:16px;padding:13px;margin-bottom:10px}.pres-head{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}.pres-title{font-weight:950;font-size:1rem}.pres-meta{font-size:.75rem;color:var(--muted);line-height:1.4;margin-top:3px}.pres-total{font-size:1.2rem;font-weight:950;color:var(--amarillo);white-space:nowrap}.pres-lines{margin:10px 0 0;padding:9px 10px;border-radius:12px;background:rgba(0,0,0,.16);border:1px solid rgba(255,255,255,.04)}.pres-line{display:flex;justify-content:space-between;gap:10px;font-size:.78rem;color:#cfc8b8;padding:3px 0}.modal-title small{display:block;color:var(--muted);font-size:.7rem;margin-top:4px;letter-spacing:0;text-transform:none}.modal-sticky-total{position:sticky;bottom:-18px;background:linear-gradient(180deg,rgba(23,23,23,.88),var(--gris-oscuro));padding-top:10px;border-top:1px solid var(--gris-borde);margin-top:12px}.input-hint{font-size:.68rem;color:var(--muted);margin-top:4px}.toast{position:fixed;left:50%;bottom:26px;transform:translateX(-50%);background:#111;border:1px solid var(--amarillo);color:var(--blanco);border-radius:999px;padding:10px 14px;font-size:.82rem;font-weight:850;z-index:500;box-shadow:var(--shadow);opacity:0;pointer-events:none;transition:.25s}.toast.show{opacity:1;bottom:34px}.danger-zone{border-color:rgba(227,93,93,.35);background:rgba(227,93,93,.06)}
@media(max-width:430px){.pres-head{align-items:stretch}.pres-total{text-align:right}.floating-add{bottom:14px;right:14px;width:52px;height:52px}.mini-btn{font-size:.64rem;padding:7px 8px}}
</style>
</head>
<body>
<nav class="no-print">
  <div class="nav-brand brand-font">JM PRO</div>
  <button class="nav-btn active" onclick="showSection('dashboard')">Dashboard</button>
  <button class="nav-btn" onclick="showSection('movimientos')">Ingresos/Gastos</button>
  <button class="nav-btn" onclick="showSection('presupuestos')">Presupuestos</button>
  <button class="nav-btn" onclick="showSection('clientes')">Clientes</button>
  <button class="nav-btn" onclick="showSection('precios')">Precios</button>
  <button class="nav-btn" onclick="showSection('archivos')">Archivos</button>
  <button class="nav-btn" onclick="showSection('ajustes')">⚙️ Ajustes</button>
</nav>

<div id="print-area" class="print-area"></div>

<!-- DASHBOARD -->
<section class="section active" id="dashboard">
  <div class="stats-grid">
    <div class="stat-card"><div class="stat-value verde" id="stat-ingresos">0 €</div><div class="stat-label">Ingresos mes</div></div>
    <div class="stat-card"><div class="stat-value rojo" id="stat-gastos">0 €</div><div class="stat-label">Gastos mes</div></div>
    <div class="stat-card"><div class="stat-value" id="stat-beneficio">0 €</div><div class="stat-label">Beneficio neto</div></div>
    <div class="stat-card"><div class="stat-value azul" id="stat-pendiente">0 €</div><div class="stat-label">Pendiente cobro</div></div>
  </div>
  <div class="card">
    <div class="card-title">📊 Resumen del mes</div>
    <div class="total-row"><span class="label">Total ingresos</span><span id="dash-ing" class="verde">0 €</span></div>
    <div class="total-row"><span class="label">Total gastos</span><span id="dash-gas" class="rojo">0 €</span></div>
    <div class="total-row"><span class="label">IVA estimado ingresos 21%</span><span id="dash-iva">0 €</span></div>
    <div class="total-row"><span class="label">IRPF orientativo 20% sobre beneficio</span><span id="dash-irpf">0 €</span></div>
    <div class="sep"></div>
    <div class="total-row grande"><span>Beneficio neto</span><span id="dash-ben">0 €</span></div>
    <div class="margen-bar"><div class="margen-fill" id="dash-bar" style="width:0%"></div></div>
    <div style="display:flex;justify-content:space-between;font-size:.72rem;color:var(--muted);margin-top:5px"><span id="dash-margen-pct">Margen 0%</span><span id="dash-mes"></span></div>
  </div>
  <div id="dash-alertas"></div>
  <div class="card">
    <div class="card-title">⚡ Acciones rápidas</div>
    <div class="grid2">
      <button class="btn" onclick="showSection('movimientos');openMovModal('ingreso')">+ Ingreso</button>
      <button class="btn btn-ghost" onclick="showSection('movimientos');openMovModal('gasto')">+ Gasto</button>
      <button class="btn btn-ghost" onclick="showSection('presupuestos');openPresModal()" style="grid-column:1/-1">+ Presupuesto profesional</button>
    </div>
  </div>
  <div class="card"><div class="card-title">📋 Últimos movimientos</div><div id="dash-movimientos"><div class="empty"><div class="empty-icon">📭</div><p>Sin movimientos aún</p></div></div></div>
  <div class="card"><div class="card-title">📌 Presupuestos pendientes</div><div id="dash-pendientes"><div class="empty"><div class="empty-icon">📄</div><p>Sin pendientes</p></div></div></div>
</section>

<!-- MOVIMIENTOS -->
<section class="section" id="movimientos">
  <div class="tab-group">
    <button class="tab-pill active" onclick="filtrarMov('todos')">Todos</button>
    <button class="tab-pill" onclick="filtrarMov('ingreso')">Ingresos</button>
    <button class="tab-pill" onclick="filtrarMov('gasto')">Gastos</button>
  </div>
  <input class="search campo" id="buscar-mov" placeholder="Buscar movimiento, cliente, categoría..." oninput="renderMovimientos()" style="margin-bottom:12px">
  <div class="card" id="lista-movimientos"></div>
  <button class="btn" onclick="openMovModal()">+ Añadir movimiento</button>
</section>

<!-- PRESUPUESTOS -->
<section class="section" id="presupuestos">
  <div class="tab-group">
    <button class="tab-pill active" onclick="filtrarPres('todos')">Todos</button>
    <button class="tab-pill" onclick="filtrarPres('pendiente')">Pendientes</button>
    <button class="tab-pill" onclick="filtrarPres('aceptado')">Aceptados</button>
    <button class="tab-pill" onclick="filtrarPres('rechazado')">Rechazados</button>
  </div>
  <div class="toolbar">
    <input class="search campo" id="buscar-pres" placeholder="Buscar cliente, dirección o trabajo..." oninput="renderPresupuestos()">
    <select id="orden-pres" class="select-inline" onchange="renderPresupuestos()">
      <option value="reciente">Más recientes</option>
      <option value="importe">Mayor importe</option>
      <option value="cliente">Cliente A-Z</option>
      <option value="estado">Estado</option>
    </select>
  </div>
  <div id="lista-presupuestos"></div>
  <button class="btn floating-add" onclick="openPresModal()">+</button>
</section>

<!-- CLIENTES -->
<section class="section" id="clientes">
  <div class="card">
    <div class="card-title">👥 Clientes guardados</div>
    <p class="help">Se crean automáticamente al guardar ingresos o presupuestos. Pulsa el botón de WhatsApp 🟢 para abrir el chat directo.</p>
    <div id="lista-clientes"></div>
  </div>
</section>

<!-- PRECIOS -->
<section class="section" id="precios">
  <div class="card">
    <div class="card-title">💶 Precios de referencia Madrid 2026</div>
    <p class="help">Tarifas orientativas para no regalar mano de obra. Ajusta según dificultad, aparcamiento, urgencia, altura, desplazamiento y materiales.</p>
    <div class="precio-ref-grid" id="grid-precios"></div>
  </div>
  <div class="card">
    <div class="card-title">⏱ Calculadora rápida</div>
    <div class="fila3">
      <div class="campo"><label>Horas</label><input type="number" id="calc-horas" placeholder="3" min="0" step="0.5" oninput="calcPrecio()"></div>
      <div class="campo"><label>€/h</label><input type="number" id="calc-tarifa" value="45" min="0" step="1" oninput="calcPrecio()"></div>
      <div class="campo"><label>Materiales</label><input type="number" id="calc-mat" placeholder="0" min="0" step="1" oninput="calcPrecio()"></div>
    </div>
    <div class="fila2">
      <div class="campo"><label>Margen materiales %</label><input type="number" id="calc-margen" value="20" min="0" step="1" oninput="calcPrecio()"></div>
      <div class="campo"><label>Desplazamiento</label><input type="number" id="calc-desp" value="25" min="0" step="1" oninput="calcPrecio()"></div>
    </div>
    <div class="sep"></div>
    <div class="total-row"><span class="label">Mano de obra</span><span id="calc-mo">0 €</span></div>
    <div class="total-row"><span class="label">Materiales con margen</span><span id="calc-mat-r">0 €</span></div>
    <div class="total-row"><span class="label">Desplazamiento</span><span id="calc-desp-r">0 €</span></div>
    <div class="total-row grande"><span>Total recomendado</span><span id="calc-total">0 €</span></div>
  </div>
  <div class="card">
    <div class="card-title">🧠 Regla rápida de precio</div>
    <div class="pill-note">Para trabajos pequeños en Madrid no bajes de 60–90 € aunque tardes poco. Añade desplazamiento, aparcamiento, compra de material, garantía y riesgo de imprevistos.</div>
  </div>
</section>

<!-- ARCHIVOS -->
<section class="section" id="archivos">
  <div class="card"><div class="card-title">💾 Copia de seguridad completa</div><p class="help">Descarga todos tus datos en JSON. Guárdalo en Google Drive o en una carpeta segura.</p><button class="btn" onclick="exportarJSON()">⬇ Descargar copia</button></div>
  <div class="card"><div class="card-title">📂 Exportar a Excel / Sheets</div><p class="help">CSV separado por punto y coma, preparado para Excel en español.</p><div class="grid2"><button class="btn" onclick="exportarCSV('movimientos')">Ingresos/Gastos</button><button class="btn btn-ghost" onclick="exportarCSV('presupuestos')">Presupuestos</button></div></div>
  <div class="card"><div class="card-title">📤 Restaurar copia</div><p class="help">Carga un backup anterior. Ojo: reemplaza los datos actuales.</p><div class="campo"><label>Archivo .json</label><input type="file" id="archivo-restaurar" accept=".json" onchange="restaurarJSON(this)"></div></div>
  <div class="card"><div class="card-title">🗓 Informe mensual para gestoría</div><div class="fila2"><div class="campo"><label>Mes</label><select id="informe-mes"></select></div><div class="campo"><label>Año</label><input type="number" id="informe-anyo" value="2026" min="2024" max="2035"></div></div><button class="btn" onclick="exportarInforme()">⬇ Descargar informe TXT</button></div>
  <div class="card"><div class="card-title">📋 Historial de exportaciones</div><div id="historial-archivos"></div></div>
</section>

<!-- AJUSTES -->
<section class="section" id="ajustes">
  <div class="card">
    <div class="card-title">🏢 Datos de empresa</div>
    <p class="help">Estos datos aparecerán en todos los presupuestos PDF.</p>
    <div class="campo"><label>Nombre empresa</label><input id="cfg-empresa" placeholder="JM Servicios Integrales" oninput="saveConfig()"></div>
    <div class="fila2">
      <div class="campo"><label>Teléfono</label><input id="cfg-tel" placeholder="747 749 930" oninput="saveConfig()"></div>
      <div class="campo"><label>Email</label><input id="cfg-email" placeholder="perezjuanmanuel660@gmail.com" oninput="saveConfig()"></div>
    </div>
    <div class="campo"><label>Ciudad / Dirección fiscal</label><input id="cfg-ciudad" placeholder="Madrid" oninput="saveConfig()"></div>
    <div class="campo"><label>CIF / NIF (opcional)</label><input id="cfg-nif" placeholder="12345678A" oninput="saveConfig()"></div>
  </div>
  <div class="card">
    <div class="card-title">🖼️ Logo de empresa</div>
    <p class="help">Sube tu logo una vez y aparecerá en todos los PDFs de presupuestos.</p>
    <div id="logo-drop-area" class="logo-upload-area" onclick="document.getElementById('logo-file-input').click()">
      <div id="logo-preview-wrap">
        <div style="font-size:2rem;margin-bottom:6px">🖼️</div>
        <div style="font-size:.82rem;color:var(--muted)">Toca para subir logo (PNG, JPG)</div>
      </div>
    </div>
    <input type="file" id="logo-file-input" accept="image/*" style="display:none" onchange="cargarLogo(this)">
    <button class="btn btn-ghost btn-sm" style="margin-top:10px" onclick="borrarLogo()">🗑 Quitar logo</button>
  </div>
  <div class="card">
    <div class="card-title">🔢 Numeración de presupuestos</div>
    <p class="help">El siguiente presupuesto se numerará como <span id="preview-num" class="num-badge">PRE-2026-001</span></p>
    <div class="campo"><label>Número actual del contador</label><input type="number" id="cfg-contador" min="1" value="1" oninput="saveConfig();updatePreviewNum()"></div>
    <div class="campo"><label>Prefijo</label><input id="cfg-prefijo" value="PRE" placeholder="PRE" oninput="saveConfig();updatePreviewNum()"></div>
  </div>
  <div class="card danger-zone">
    <div class="card-title">⚠️ Zona de peligro</div>
    <button class="btn btn-danger btn-sm" onclick="borrarTodo()">🗑 Borrar todos los datos</button>
  </div>
</section>

<!-- MODAL MOVIMIENTO -->
<div class="modal-overlay" id="modal-mov">
  <div class="modal">
    <button class="modal-close" onclick="closeModal('modal-mov')">✕</button>
    <div class="modal-title">Añadir movimiento</div>
    <div class="campo"><label>Tipo</label><select id="mov-tipo"><option value="ingreso">Ingreso</option><option value="gasto">Gasto</option></select></div>
    <div class="campo"><label>Concepto</label><input id="mov-concepto" placeholder="Ej: Instalación de split"></div>
    <div class="fila2">
      <div class="campo"><label>Cliente/Proveedor</label><input id="mov-cliente" placeholder="Nombre"></div>
      <div class="campo"><label>Teléfono</label><input id="mov-telefono" placeholder="Teléfono"></div>
    </div>
    <div class="campo"><label>Dirección</label><input id="mov-direccion" placeholder="Dirección del trabajo"></div>
    <div class="fila2">
      <div class="campo"><label>Importe (€)</label><input type="number" id="mov-importe" min="0" step="0.01"></div>
      <div class="campo"><label>Fecha</label><input type="date" id="mov-fecha"></div>
    </div>
    <div class="campo"><label>Categoría</label><select id="mov-categoria"><option>Trabajo realizado</option><option>Material</option><option>Furgoneta / Combustible</option><option>Herramientas</option><option>Gestoría / Impuestos</option><option>Cuota autónomo</option><option>Publicidad</option><option>Parking / SER</option><option>Otro</option></select></div>
    <button class="btn" onclick="guardarMovimiento()">Guardar</button>
  </div>
</div>

<!-- MODAL PRESUPUESTO -->
<div class="modal-overlay" id="modal-pres">
  <div class="modal">
    <button class="modal-close" onclick="closeModal('modal-pres')">✕</button>
    <div class="modal-title" id="pres-modal-title">Presupuesto profesional<small>Rellena, edita y guarda los cambios</small></div>
    <div class="fila2">
      <div class="campo"><label>Cliente</label><input id="pres-cliente" placeholder="Nombre cliente"></div>
      <div class="campo"><label>Teléfono</label><input id="pres-telefono" placeholder="Teléfono"></div>
    </div>
    <div class="campo"><label>Dirección del trabajo</label><input id="pres-direccion" placeholder="Calle, zona, municipio"></div>
    <div class="campo"><label>Descripción del trabajo</label><textarea id="pres-desc" placeholder="Describe bien el trabajo, alcance y condiciones..."></textarea></div>
    <div class="fila3">
      <div class="campo"><label>Fecha</label><input type="date" id="pres-fecha"></div>
      <div class="campo"><label>Validez días</label><input type="number" id="pres-validez" value="15"></div>
      <div class="campo"><label>Estado</label><select id="pres-estado"><option value="pendiente">Pendiente</option><option value="aceptado">Aceptado</option><option value="rechazado">Rechazado</option></select></div>
    </div>
    <div class="card-title" style="margin-top:8px">Partidas</div>
    <div class="partida-row" style="color:var(--muted);font-size:.68rem;text-transform:uppercase;font-weight:900"><span>Descripción</span><span>Cantidad</span><span>Precio</span><span></span></div>
    <div id="partidas-container"></div>
    <button class="btn btn-ghost btn-sm" onclick="addPartida()" style="margin-bottom:10px">+ Añadir partida</button>
    <div class="fila3">
      <div class="campo"><label>Desplazamiento</label><input type="number" id="pres-desp" value="25" min="0" step="0.01" oninput="updateTotalPres()"></div>
      <div class="campo"><label>IVA %</label><input type="number" id="pres-iva" value="21" min="0" step="1" oninput="updateTotalPres()"></div>
      <div class="campo"><label>Descuento €</label><input type="number" id="pres-descuento" value="0" min="0" step="0.01" oninput="updateTotalPres()"></div>
    </div>
    <div class="campo"><label>Condiciones / forma de pago</label><textarea id="pres-condiciones">Forma de pago: 50% para reserva de materiales y 50% al finalizar. Presupuesto válido durante 15 días. Materiales incluidos solo si aparecen en las partidas. Garantía según normativa vigente.</textarea></div>
    <div class="sep"></div>
    <div class="total-row"><span class="label">Subtotal</span><span id="pres-subtotal">0 €</span></div>
    <div class="total-row"><span class="label">Desplazamiento</span><span id="pres-desp-r">0 €</span></div>
    <div class="total-row"><span class="label">Descuento</span><span id="pres-desc-r">0 €</span></div>
    <div class="total-row"><span class="label">IVA</span><span id="pres-iva-r">0 €</span></div>
    <div class="total-row grande"><span>Total</span><span id="pres-total">0 €</span></div>
    <div class="modal-sticky-total">
      <button class="btn" id="btn-guardar-pres" onclick="guardarPresupuesto()" style="margin-top:8px">Guardar presupuesto</button>
    </div>
  </div>
</div>

<!-- MODAL PDF+WHATSAPP -->
<div class="modal-overlay" id="modal-wa">
  <div class="modal">
    <button class="modal-close" onclick="closeModal('modal-wa')">✕</button>
    <div class="modal-title">📤 Enviar presupuesto</div>
    <p class="help" style="margin-bottom:16px">El PDF se descargará en tu dispositivo. Después podrás adjuntarlo en WhatsApp.</p>
    <div id="wa-info" style="margin-bottom:14px"></div>
    <button class="btn" onclick="ejecutarDescargaPDF()" style="margin-bottom:10px">⬇️ Descargar PDF</button>
    <button class="btn btn-wa" onclick="abrirWhatsApp()">📲 Abrir WhatsApp</button>
    <div class="wa-action" style="margin-top:12px">
      <div style="font-size:.78rem;color:#a8f0c0;font-weight:900;margin-bottom:6px">📋 PASOS</div>
      <div style="font-size:.78rem;color:#c8e8d8;line-height:1.7">1. Pulsa "Descargar PDF" → el archivo se guarda<br>2. Pulsa "Abrir WhatsApp" → se abre el chat<br>3. En WhatsApp, pulsa el clip 📎 y adjunta el PDF</div>
    </div>
  </div>
</div>

<div id="toast" class="toast"></div>

<script>
// ===================== ESTADO GLOBAL =====================
let movimientos = JSON.parse(localStorage.getItem('jm_movimientos') || '[]');
let presupuestos = JSON.parse(localStorage.getItem('jm_presupuestos') || '[]');
let historialExport = JSON.parse(localStorage.getItem('jm_historial_export') || '[]');
let filtroMov = 'todos';
let filtroPres = 'todos';
let editPresId = null;
let waPresId = null;
let logoBase64 = localStorage.getItem('jm_logo') || null;

const meses = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];
const PRECIOS_REF = [
  {nombre:'Visita / diagnóstico',rango:'45-70 €',unit:'mínimo salida'},
  {nombre:'Hora profesional',rango:'40-60 €',unit:'por hora'},
  {nombre:'Urgencia tarde/noche',rango:'+30-60 €',unit:'suplemento'},
  {nombre:'Instalación split',rango:'280-450 €',unit:'mano obra'},
  {nombre:'Mantenimiento aire',rango:'60-110 €',unit:'por equipo'},
  {nombre:'Punto de luz',rango:'60-95 €',unit:'por punto'},
  {nombre:'Enchufe / mecanismo',rango:'45-80 €',unit:'por unidad'},
  {nombre:'Cambio bombín',rango:'70-120 €',unit:'por unidad'},
  {nombre:'Fontanería pequeña',rango:'60-120 €',unit:'trabajo mínimo'},
  {nombre:'Radiador línea multicapa',rango:'180-320 €',unit:'por radiador'},
  {nombre:'Alicatado',rango:'25-45 €',unit:'por m²'},
  {nombre:'Suelo laminado',rango:'18-32 €',unit:'por m²'},
  {nombre:'Rodapié',rango:'8-15 €',unit:'metro lineal'},
  {nombre:'Pintura interior',rango:'5-10 €',unit:'por m²'},
  {nombre:'Puerta interior',rango:'100-180 €',unit:'instalación'},
  {nombre:'Montaje mueble',rango:'45-120 €',unit:'según tamaño'}
];

// ===================== CONFIG =====================
function getConfig() {
  return JSON.parse(localStorage.getItem('jm_config') || '{}');
}
function saveConfig() {
  const cfg = {
    empresa: document.getElementById('cfg-empresa')?.value || 'JM Servicios Integrales',
    tel: document.getElementById('cfg-tel')?.value || '747 749 930',
    email: document.getElementById('cfg-email')?.value || 'perezjuanmanuel660@gmail.com',
    ciudad: document.getElementById('cfg-ciudad')?.value || 'Madrid',
    nif: document.getElementById('cfg-nif')?.value || '',
    contador: parseInt(document.getElementById('cfg-contador')?.value) || 1,
    prefijo: document.getElementById('cfg-prefijo')?.value || 'PRE'
  };
  localStorage.setItem('jm_config', JSON.stringify(cfg));
}
function loadConfig() {
  const cfg = getConfig();
  const set = (id, val) => { const el = document.getElementById(id); if(el) el.value = val || ''; };
  set('cfg-empresa', cfg.empresa || 'JM Servicios Integrales');
  set('cfg-tel', cfg.tel || '747 749 930');
  set('cfg-email', cfg.email || 'perezjuanmanuel660@gmail.com');
  set('cfg-ciudad', cfg.ciudad || 'Madrid');
  set('cfg-nif', cfg.nif || '');
  set('cfg-contador', cfg.contador || 1);
  set('cfg-prefijo', cfg.prefijo || 'PRE');
  updatePreviewNum();
  renderLogoPreview();
}
function updatePreviewNum() {
  const cfg = getConfig();
  const prefijo = document.getElementById('cfg-prefijo')?.value || cfg.prefijo || 'PRE';
  const contador = parseInt(document.getElementById('cfg-contador')?.value) || cfg.contador || 1;
  const anyo = new Date().getFullYear();
  const el = document.getElementById('preview-num');
  if(el) el.textContent = `${prefijo}-${anyo}-${String(contador).padStart(3,'0')}`;
}
function getNextNumero() {
  const cfg = getConfig();
  const prefijo = cfg.prefijo || 'PRE';
  const anyo = new Date().getFullYear();
  const contador = cfg.contador || 1;
  return `${prefijo}-${anyo}-${String(contador).padStart(3,'0')}`;
}
function incrementarContador() {
  const cfg = getConfig();
  cfg.contador = (cfg.contador || 1) + 1;
  localStorage.setItem('jm_config', JSON.stringify(cfg));
  loadConfig();
}

// ===================== LOGO =====================
function cargarLogo(input) {
  const file = input.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = e => {
    logoBase64 = e.target.result;
    localStorage.setItem('jm_logo', logoBase64);
    renderLogoPreview();
    toast('Logo guardado ✓');
  };
  reader.readAsDataURL(file);
}
function borrarLogo() {
  logoBase64 = null;
  localStorage.removeItem('jm_logo');
  renderLogoPreview();
  toast('Logo eliminado');
}
function renderLogoPreview() {
  const wrap = document.getElementById('logo-preview-wrap');
  if(!wrap) return;
  if(logoBase64) {
    wrap.innerHTML = `<img src="${logoBase64}" class="logo-preview" alt="Logo"><br><div style="font-size:.72rem;color:var(--verde);margin-top:6px">✓ Logo cargado</div>`;
  } else {
    wrap.innerHTML = `<div style="font-size:2rem;margin-bottom:6px">🖼️</div><div style="font-size:.82rem;color:var(--muted)">Toca para subir logo (PNG, JPG)</div>`;
  }
}

// ===================== UTILIDADES =====================
function toast(msg) {
  const t = document.getElementById('toast');
  if(!t) return;
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2400);
}
function escapeHTML(str) {
  return String(str || '').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
}
function showSection(id) {
  document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
  document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  const ids = ['dashboard','movimientos','presupuestos','clientes','precios','archivos','ajustes'];
  document.querySelectorAll('.nav-btn')[ids.indexOf(id)]?.classList.add('active');
  if(id === 'dashboard') renderDashboard();
  if(id === 'movimientos') renderMovimientos();
  if(id === 'presupuestos') renderPresupuestos();
  if(id === 'clientes') renderClientes();
  if(id === 'precios') renderPrecios();
  if(id === 'archivos') renderHistorialArchivos();
  if(id === 'ajustes') loadConfig();
}
function openModal(id) { document.getElementById(id).classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }
function today() { return new Date().toISOString().split('T')[0]; }
function fmt(n) { n = parseFloat(n) || 0; return n.toFixed(2).replace('.', ',') + ' €'; }
function fmtFecha(f) { if(!f) return ''; return new Date(f + 'T00:00:00').toLocaleDateString('es-ES', {day:'2-digit', month:'short', year:'numeric'}); }
function clean(s) { return String(s || '').replace(/[;&\n\r]/g, ' ').trim(); }
function save() {
  localStorage.setItem('jm_movimientos', JSON.stringify(movimientos));
  localStorage.setItem('jm_presupuestos', JSON.stringify(presupuestos));
}

// ===================== MOVIMIENTOS =====================
function openMovModal(tipo) {
  ['mov-concepto','mov-cliente','mov-telefono','mov-direccion','mov-importe'].forEach(id => document.getElementById(id).value = '');
  document.getElementById('mov-fecha').value = today();
  if(tipo) document.getElementById('mov-tipo').value = tipo;
  openModal('modal-mov');
}
function guardarMovimiento() {
  const concepto = document.getElementById('mov-concepto').value.trim();
  const importe = parseFloat(document.getElementById('mov-importe').value);
  if(!concepto || !importe) { alert('Rellena concepto e importe'); return; }
  movimientos.unshift({
    id: Date.now(),
    tipo: document.getElementById('mov-tipo').value,
    concepto,
    cliente: document.getElementById('mov-cliente').value.trim(),
    telefono: document.getElementById('mov-telefono').value.trim(),
    direccion: document.getElementById('mov-direccion').value.trim(),
    importe,
    fecha: document.getElementById('mov-fecha').value,
    categoria: document.getElementById('mov-categoria').value
  });
  save(); closeModal('modal-mov'); renderMovimientos(); renderDashboard();
}
function eliminarMovimiento(id) {
  if(!confirm('¿Eliminar este movimiento?')) return;
  movimientos = movimientos.filter(m => m.id !== id);
  save(); renderMovimientos(); renderDashboard();
}
function filtrarMov(f) {
  filtroMov = f;
  document.querySelectorAll('#movimientos .tab-pill').forEach((p,i) => p.classList.toggle('active', ['todos','ingreso','gasto'][i] === f));
  renderMovimientos();
}
function renderMovimientos() {
  const lista = document.getElementById('lista-movimientos');
  const q = (document.getElementById('buscar-mov')?.value || '').toLowerCase();
  const fil = (filtroMov === 'todos' ? movimientos : movimientos.filter(m => m.tipo === filtroMov)).filter(m => JSON.stringify(m).toLowerCase().includes(q));
  if(!fil.length) { lista.innerHTML = '<div class="empty"><div class="empty-icon">💸</div><p>Sin movimientos</p></div>'; return; }
  lista.innerHTML = fil.map(m => `<div class="item-row"><div class="item-info"><div class="item-title">${m.concepto}</div><div class="item-sub">${m.cliente ? m.cliente + ' · ' : ''}${m.categoria} · ${fmtFecha(m.fecha)}${m.direccion ? ' · ' + m.direccion : ''}</div></div><div style="display:flex;align-items:center;gap:10px"><div class="item-amount ${m.tipo === 'ingreso' ? 'verde' : 'rojo'}">${m.tipo === 'ingreso' ? '+' : '-'}${fmt(m.importe)}</div><button onclick="eliminarMovimiento(${m.id})" style="background:none;border:0;color:var(--muted);font-size:1rem">✕</button></div></div>`).join('');
}

// ===================== PRESUPUESTOS =====================
function openPresModal(p = null) {
  editPresId = p?.id || null;
  document.getElementById('pres-modal-title').innerHTML = (editPresId ? 'Editar presupuesto' : 'Nuevo presupuesto') + '<small>' + (editPresId ? 'Modifica los datos y pulsa guardar cambios' : 'Rellena, edita y guarda los cambios') + '</small>';
  document.getElementById('btn-guardar-pres').textContent = editPresId ? 'Guardar cambios' : 'Guardar presupuesto';
  ['pres-cliente','pres-telefono','pres-direccion','pres-desc'].forEach(id => document.getElementById(id).value = p?.[id.replace('pres-', '')] || '');
  document.getElementById('pres-fecha').value = p?.fecha || today();
  document.getElementById('pres-validez').value = p?.validez || 15;
  document.getElementById('pres-estado').value = p?.estado || 'pendiente';
  document.getElementById('pres-desp').value = p?.desplazamiento ?? 25;
  document.getElementById('pres-iva').value = p?.ivaPct ?? 21;
  document.getElementById('pres-descuento').value = p?.descuento ?? 0;
  document.getElementById('pres-condiciones').value = p?.condiciones || 'Forma de pago: 50% para reserva de materiales y 50% al finalizar. Presupuesto válido durante 15 días. Materiales incluidos solo si aparecen en las partidas. Garantía según normativa vigente.';
  document.getElementById('partidas-container').innerHTML = '';
  (p?.partidas?.length ? p.partidas : [{desc: 'Mano de obra', cant: 1, precio: 0}]).forEach(x => addPartida(x));
  updateTotalPres();
  openModal('modal-pres');
}
function addPartida(x = {desc: '', cant: 1, precio: 0}) {
  const c = document.getElementById('partidas-container');
  const id = Date.now() + Math.random();
  const div = document.createElement('div');
  div.className = 'partida-row';
  div.id = 'partida-' + id;
  div.innerHTML = `<input placeholder="Descripción" value="${(x.desc || '').replaceAll('"', '&quot;')}" oninput="updateTotalPres()"><input type="number" min="0" step="0.01" value="${x.cant ?? 1}" oninput="updateTotalPres()"><input type="number" min="0" step="0.01" value="${x.precio ?? 0}" oninput="updateTotalPres()"><button onclick="document.getElementById('partida-${id}').remove();updateTotalPres()" style="background:none;border:0;color:var(--rojo);font-size:1.1rem">✕</button>`;
  c.appendChild(div);
}
function getPartidas() {
  const arr = [];
  document.querySelectorAll('#partidas-container .partida-row').forEach(r => {
    const ins = r.querySelectorAll('input');
    const desc = ins[0].value.trim(), cant = parseFloat(ins[1].value) || 0, precio = parseFloat(ins[2].value) || 0;
    if(desc || precio) arr.push({desc, cant, precio, total: cant * precio});
  });
  return arr;
}
function calcPres() {
  const partidas = getPartidas();
  const subtotal = partidas.reduce((s, p) => s + p.total, 0);
  const desp = parseFloat(document.getElementById('pres-desp').value) || 0;
  const desc = parseFloat(document.getElementById('pres-descuento').value) || 0;
  const ivaPct = parseFloat(document.getElementById('pres-iva').value) || 0;
  const base = Math.max(0, subtotal + desp - desc);
  const iva = base * ivaPct / 100;
  const total = base + iva;
  return {partidas, subtotal, desp, desc, ivaPct, iva, total, base};
}
function updateTotalPres() {
  const c = calcPres();
  document.getElementById('pres-subtotal').textContent = fmt(c.subtotal);
  document.getElementById('pres-desp-r').textContent = fmt(c.desp);
  document.getElementById('pres-desc-r').textContent = '-' + fmt(c.desc);
  document.getElementById('pres-iva-r').textContent = fmt(c.iva);
  document.getElementById('pres-total').textContent = fmt(c.total);
}
function guardarPresupuesto() {
  const cliente = document.getElementById('pres-cliente').value.trim();
  if(!cliente) { alert('Introduce el nombre del cliente'); return; }
  const c = calcPres();
  const esNuevo = !editPresId;
  const numero = esNuevo ? getNextNumero() : (presupuestos.find(p => p.id === editPresId)?.numero || getNextNumero());
  const obj = {
    id: editPresId || Date.now(),
    numero,
    cliente,
    telefono: document.getElementById('pres-telefono').value.trim(),
    direccion: document.getElementById('pres-direccion').value.trim(),
    desc: document.getElementById('pres-desc').value.trim(),
    fecha: document.getElementById('pres-fecha').value,
    estado: document.getElementById('pres-estado').value,
    validez: parseInt(document.getElementById('pres-validez').value) || 15,
    partidas: c.partidas,
    subtotal: c.subtotal,
    desplazamiento: c.desp,
    descuento: c.desc,
    ivaPct: c.ivaPct,
    iva: c.iva,
    base: c.base,
    total: c.total,
    condiciones: document.getElementById('pres-condiciones').value.trim()
  };
  if(editPresId) {
    presupuestos = presupuestos.map(p => p.id === editPresId ? obj : p);
  } else {
    presupuestos.unshift(obj);
    incrementarContador();
  }
  save(); closeModal('modal-pres'); renderPresupuestos(); renderDashboard();
  toast('Presupuesto ' + numero + ' guardado ✓');
}
function filtrarPres(f) {
  filtroPres = f;
  document.querySelectorAll('#presupuestos .tab-pill').forEach((p,i) => p.classList.toggle('active', ['todos','pendiente','aceptado','rechazado'][i] === f));
  renderPresupuestos();
}
function cambiarEstado(id, estado) {
  const p = presupuestos.find(p => p.id === id);
  if(p) { p.estado = estado; save(); renderPresupuestos(); renderDashboard(); }
}
function marcarAceptado(id) { cambiarEstado(id, 'aceptado'); toast('Marcado como aceptado'); }
function marcarPendiente(id) { cambiarEstado(id, 'pendiente'); toast('Marcado como pendiente'); }
function marcarRechazado(id) { cambiarEstado(id, 'rechazado'); toast('Marcado como rechazado'); }
function eliminarPresupuesto(id) {
  if(!confirm('¿Eliminar presupuesto?')) return;
  presupuestos = presupuestos.filter(p => p.id !== id);
  save(); renderPresupuestos(); renderDashboard();
}
function presupuestoAIngreso(id) {
  const p = presupuestos.find(p => p.id === id);
  if(!p) return;
  movimientos.unshift({
    id: Date.now(), tipo: 'ingreso',
    concepto: 'Cobro presupuesto: ' + (p.desc || 'Trabajo') + ' (' + (p.numero || '') + ')',
    cliente: p.cliente, telefono: p.telefono, direccion: p.direccion,
    importe: p.total, fecha: today(), categoria: 'Trabajo realizado'
  });
  p.estado = 'aceptado';
  save(); toast('Presupuesto pasado a ingreso'); renderPresupuestos(); renderDashboard();
}
function duplicatePresupuesto(id) {
  const p = presupuestos.find(x => x.id === id);
  if(!p) return;
  const copia = JSON.parse(JSON.stringify(p));
  copia.id = Date.now();
  copia.numero = getNextNumero();
  copia.fecha = today();
  copia.estado = 'pendiente';
  presupuestos.unshift(copia);
  incrementarContador();
  save(); renderPresupuestos(); renderDashboard();
  toast('Duplicado como ' + copia.numero);
}
function renderPresupuestos() {
  const lista = document.getElementById('lista-presupuestos');
  const q = (document.getElementById('buscar-pres')?.value || '').toLowerCase();
  const orden = document.getElementById('orden-pres')?.value || 'reciente';
  let fil = (filtroPres === 'todos' ? presupuestos : presupuestos.filter(p => p.estado === filtroPres)).filter(p => JSON.stringify(p).toLowerCase().includes(q));
  if(orden === 'importe') fil.sort((a,b) => (b.total||0) - (a.total||0));
  else if(orden === 'cliente') fil.sort((a,b) => (a.cliente||'').localeCompare(b.cliente||''));
  else if(orden === 'estado') fil.sort((a,b) => (a.estado||'').localeCompare(b.estado||''));
  else fil.sort((a,b) => (b.id||0) - (a.id||0));
  if(!fil.length) { lista.innerHTML = '<div class="card"><div class="empty"><div class="empty-icon">📄</div><p>Sin presupuestos</p></div></div>'; return; }
  lista.innerHTML = fil.map(p => {
    const bc = p.estado === 'aceptado' ? 'badge-verde' : p.estado === 'rechazado' ? 'badge-rojo' : 'badge-amarillo';
    const numLabel = p.numero ? `<span class="num-badge">${p.numero}</span> ` : '';
    const lineas = (p.partidas || []).slice(0,4).map(pt => `<div class="pres-line"><span>· ${escapeHTML(pt.desc)}</span><b>${fmt(pt.total ?? pt.precio)}</b></div>`).join('');
    const extra = (p.partidas || []).length > 4 ? `<div class="pres-line"><span>+ ${(p.partidas||[]).length - 4} partidas más</span><b></b></div>` : '';
    return `<div class="pres-card"><div class="pres-head"><div><div class="pres-title">${numLabel}${escapeHTML(p.cliente)}</div><div class="pres-meta">${escapeHTML(p.desc || 'Presupuesto')}<br>${fmtFecha(p.fecha)}${p.direccion ? ' · ' + escapeHTML(p.direccion) : ''}</div></div><div style="text-align:right"><div class="pres-total">${fmt(p.total)}</div><span class="badge ${bc}">${p.estado}</span></div></div>${lineas || extra ? `<div class="pres-lines">${lineas}${extra}</div>` : ''}<div class="mini-actions"><button class="mini-btn warn" onclick='openPresModal(${JSON.stringify(p).replaceAll("'", "&#39;")})'>✏️ Editar</button><button class="mini-btn" onclick="duplicatePresupuesto(${p.id})">Duplicar</button><button class="mini-btn ok" onclick="presupuestoAIngreso(${p.id})">→ Ingreso</button><button class="mini-btn" onclick="imprimirPresupuesto(${p.id})">🖨️ Imprimir</button><button class="mini-btn wa" onclick="abrirModalWA(${p.id})">📲 WhatsApp</button><button class="mini-btn" onclick="copiarPresupuesto(${p.id})">📋 Copiar</button>${p.estado !== 'aceptado' ? `<button class="mini-btn ok" onclick="marcarAceptado(${p.id})">Aceptado</button>` : ''}${p.estado !== 'pendiente' ? `<button class="mini-btn warn" onclick="marcarPendiente(${p.id})">Pendiente</button>` : ''}${p.estado !== 'rechazado' ? `<button class="mini-btn danger" onclick="marcarRechazado(${p.id})">Rechazar</button>` : ''}<button class="mini-btn danger" onclick="eliminarPresupuesto(${p.id})">Eliminar</button></div></div>`;
  }).join('');
}

// ===================== PDF con jsPDF =====================
function generarPDF(id) {
  const p = presupuestos.find(x => x.id === id);
  if(!p) return null;
  const cfg = getConfig();
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
  const W = 210, PL = 15, PR = 15, PW = W - PL - PR;
  let y = 15;

  // Cabecera — logo si existe
  if(logoBase64) {
    try {
      const ext = logoBase64.includes('image/png') ? 'PNG' : 'JPEG';
      doc.addImage(logoBase64, ext, PL, y, 40, 20);
      y += 2;
    } catch(e) {}
  }

  // Nombre empresa
  doc.setFont('helvetica', 'bold');
  doc.setFontSize(18);
  doc.setTextColor(30, 30, 30);
  const logoOffset = logoBase64 ? 45 : PL;
  doc.text(cfg.empresa || 'JM Servicios Integrales', logoOffset, y + 8);
  doc.setFont('helvetica', 'normal');
  doc.setFontSize(9);
  doc.setTextColor(100, 100, 100);
  const contactLine = [cfg.ciudad || 'Madrid', cfg.email || '', cfg.tel || ''].filter(Boolean).join(' · ');
  doc.text(contactLine, logoOffset, y + 14);
  if(cfg.nif) doc.text('NIF: ' + cfg.nif, logoOffset, y + 19);
  y += 28;

  // Línea separadora
  doc.setDrawColor(220, 220, 220);
  doc.setLineWidth(0.4);
  doc.line(PL, y, W - PR, y);
  y += 7;

  // Número y fecha de presupuesto
  doc.setFontSize(13);
  doc.setFont('helvetica', 'bold');
  doc.setTextColor(30, 30, 30);
  doc.text('PRESUPUESTO ' + (p.numero || p.id), PL, y);
  doc.setFont('helvetica', 'normal');
  doc.setFontSize(9);
  doc.setTextColor(100, 100, 100);
  doc.text('Fecha: ' + fmtFecha(p.fecha) + '   Validez: ' + p.validez + ' días', PL, y + 6);
  y += 16;

  // Datos cliente
  doc.setFillColor(245, 245, 245);
  doc.roundedRect(PL, y, PW, 26, 2, 2, 'F');
  doc.setFont('helvetica', 'bold');
  doc.setFontSize(9);
  doc.setTextColor(80, 80, 80);
  doc.text('DATOS DEL CLIENTE', PL + 4, y + 6);
  doc.setFont('helvetica', 'normal');
  doc.setFontSize(10);
  doc.setTextColor(30, 30, 30);
  doc.text('Cliente: ' + (p.cliente || '-'), PL + 4, y + 13);
  doc.text('Tel: ' + (p.telefono || '-') + '   Dir: ' + (p.direccion || '-'), PL + 4, y + 20);
  y += 32;

  // Descripción trabajo
  if(p.desc) {
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(10);
    doc.setTextColor(30, 30, 30);
    doc.text('DESCRIPCIÓN DEL TRABAJO', PL, y);
    y += 6;
    doc.setFont('helvetica', 'normal');
    doc.setFontSize(9);
    doc.setTextColor(60, 60, 60);
    const descLines = doc.splitTextToSize(p.desc, PW);
    doc.text(descLines, PL, y);
    y += descLines.length * 5 + 4;
  }

  // Tabla de partidas
  doc.setFont('helvetica', 'bold');
  doc.setFontSize(10);
  doc.setTextColor(30, 30, 30);
  doc.text('PARTIDAS', PL, y);
  y += 5;

  // Cabecera tabla
  doc.setFillColor(30, 30, 30);
  doc.rect(PL, y, PW, 8, 'F');
  doc.setTextColor(255, 255, 255);
  doc.setFontSize(8);
  doc.setFont('helvetica', 'bold');
  doc.text('Descripción', PL + 3, y + 5.5);
  doc.text('Cant.', PL + PW - 60, y + 5.5);
  doc.text('Precio', PL + PW - 40, y + 5.5);
  doc.text('Total', PL + PW - 18, y + 5.5);
  y += 8;

  // Filas de partidas
  doc.setFont('helvetica', 'normal');
  doc.setTextColor(30, 30, 30);
  (p.partidas || []).forEach((pt, i) => {
    if(i % 2 === 0) { doc.setFillColor(250, 250, 250); doc.rect(PL, y, PW, 7, 'F'); }
    doc.setFontSize(9);
    const descText = doc.splitTextToSize(pt.desc || '', PW - 80);
    doc.text(descText[0] || '', PL + 3, y + 4.8);
    doc.text(String(pt.cant), PL + PW - 60, y + 4.8);
    doc.text(fmtNum(pt.precio), PL + PW - 40, y + 4.8);
    doc.text(fmtNum(pt.total || pt.precio * pt.cant), PL + PW - 18, y + 4.8);
    y += 7;
  });

  // Totales
  y += 4;
  doc.setDrawColor(200, 200, 200);
  doc.line(PL + PW/2, y, W - PR, y);
  y += 5;
  const totalesRows = [
    ['Subtotal', fmtNum(p.subtotal)],
    ['Desplazamiento', fmtNum(p.desplazamiento)],
    ['Descuento', '-' + fmtNum(p.descuento)],
    ['IVA ' + p.ivaPct + '%', fmtNum(p.iva)],
  ];
  doc.setFontSize(9);
  totalesRows.forEach(([label, val]) => {
    doc.setFont('helvetica', 'normal');
    doc.setTextColor(80, 80, 80);
    doc.text(label, PL + PW/2 + 4, y);
    doc.setTextColor(30, 30, 30);
    doc.text(val, W - PR, y, {align: 'right'});
    y += 6;
  });

  // Total final — caja destacada
  doc.setFillColor(240, 192, 64);
  doc.roundedRect(PL + PW/2, y, PW/2, 10, 2, 2, 'F');
  doc.setFont('helvetica', 'bold');
  doc.setFontSize(12);
  doc.setTextColor(30, 30, 30);
  doc.text('TOTAL', PL + PW/2 + 4, y + 7);
  doc.text(fmtNum(p.total), W - PR, y + 7, {align: 'right'});
  y += 16;

  // Condiciones
  if(p.condiciones) {
    doc.setDrawColor(220, 220, 220);
    doc.line(PL, y, W - PR, y);
    y += 6;
    doc.setFont('helvetica', 'bold');
    doc.setFontSize(9);
    doc.setTextColor(60, 60, 60);
    doc.text('CONDICIONES', PL, y);
    y += 5;
    doc.setFont('helvetica', 'normal');
    doc.setFontSize(8);
    doc.setTextColor(100, 100, 100);
    const condLines = doc.splitTextToSize(p.condiciones, PW);
    doc.text(condLines, PL, y);
    y += condLines.length * 4.5 + 4;
  }

  // Pie de página
  doc.setFontSize(8);
  doc.setTextColor(160, 160, 160);
  doc.text('Generado por JM Servicios PRO · ' + new Date().toLocaleDateString('es-ES'), PL, 287);

  return { doc, p };
}

function fmtNum(n) {
  n = parseFloat(n) || 0;
  return n.toFixed(2).replace('.', ',') + ' €';
}

function imprimirPresupuesto(id) {
  const p = presupuestos.find(x => x.id === id);
  if(!p) return;
  const cfg = getConfig();
  const numLabel = p.numero || ('Nº ' + p.id);
  const html = `<div class="print-doc">
    <h1>${cfg.empresa || 'JM Servicios Integrales'}</h1>
    <div class="small">${cfg.ciudad || 'Madrid'} · ${cfg.email || 'perezjuanmanuel660@gmail.com'} · Tel. ${cfg.tel || '747 749 930'}</div>
    <h2>Presupuesto ${numLabel}</h2>
    <div class="box"><b>Cliente:</b> ${p.cliente}<br><b>Teléfono:</b> ${p.telefono || '-'}<br><b>Dirección:</b> ${p.direccion || '-'}<br><b>Fecha:</b> ${fmtFecha(p.fecha)} · <b>Validez:</b> ${p.validez} días</div>
    <h2>Trabajo</h2><p>${(p.desc || '').replaceAll('\n', '<br>')}</p>
    <table><thead><tr><th>Descripción</th><th class="right">Cant.</th><th class="right">Precio</th><th class="right">Total</th></tr></thead>
    <tbody>${(p.partidas || []).map(pt => `<tr><td>${pt.desc}</td><td class="right">${pt.cant}</td><td class="right">${fmt(pt.precio)}</td><td class="right">${fmt(pt.total)}</td></tr>`).join('')}</tbody></table>
    <table><tr><td>Subtotal</td><td class="right">${fmt(p.subtotal)}</td></tr><tr><td>Desplazamiento</td><td class="right">${fmt(p.desplazamiento)}</td></tr><tr><td>Descuento</td><td class="right">-${fmt(p.descuento)}</td></tr><tr><td>IVA ${p.ivaPct}%</td><td class="right">${fmt(p.iva)}</td></tr><tr class="total"><td>Total</td><td class="right">${fmt(p.total)}</td></tr></table>
    <h2>Condiciones</h2><p class="small">${(p.condiciones || '').replaceAll('\n', '<br>')}</p>
  </div>`;
  document.getElementById('print-area').innerHTML = html;
  window.print();
}

// ===================== WHATSAPP + PDF =====================
function abrirModalWA(id) {
  waPresId = id;
  const p = presupuestos.find(x => x.id === id);
  if(!p) return;
  const cfg = getConfig();
  document.getElementById('wa-info').innerHTML = `
    <div style="background:var(--gris-medio);border-radius:12px;padding:12px;font-size:.85rem;line-height:1.7">
      <div><b>Cliente:</b> ${escapeHTML(p.cliente)}</div>
      <div><b>Presupuesto:</b> ${p.numero || p.id}</div>
      <div><b>Total:</b> <span class="azul" style="font-weight:950">${fmt(p.total)}</span></div>
      ${p.telefono ? `<div><b>WhatsApp:</b> ${escapeHTML(p.telefono)}</div>` : '<div style="color:var(--rojo)">⚠️ Sin teléfono guardado</div>'}
    </div>`;
  openModal('modal-wa');
}
function ejecutarDescargaPDF() {
  if(!waPresId) return;
  const result = generarPDF(waPresId);
  if(!result) return;
  const { doc, p } = result;
  const numLabel = (p.numero || p.id).toString().replace(/[^a-zA-Z0-9-_]/g, '_');
  doc.save(`Presupuesto_${numLabel}_${p.cliente.replace(/\s+/g, '_')}.pdf`);
  registrarExport('PDF Presupuesto ' + (p.numero || p.id));
  renderHistorialArchivos();
  toast('PDF descargado ✓ Ahora abre WhatsApp y adjúntalo 📎');
}
function abrirWhatsApp() {
  if(!waPresId) return;
  const p = presupuestos.find(x => x.id === waPresId);
  if(!p) return;
  const cfg = getConfig();
  let tel = (p.telefono || '').replace(/\s+/g, '').replace(/^0/, '');
  if(tel && !tel.startsWith('+')) tel = '+34' + tel;
  const numLabel = p.numero || ('Nº ' + p.id);
  const msg = encodeURIComponent(
    `Hola ${p.cliente}, te envío el presupuesto ${numLabel} de ${cfg.empresa || 'JM Servicios Integrales'}.\n\n` +
    `💼 Trabajo: ${p.desc || 'Según presupuesto'}\n` +
    `💰 Total: ${fmtNum(p.total)} (IVA ${p.ivaPct}% incluido)\n` +
    `📅 Validez: ${p.validez} días\n\n` +
    `Adjunto el PDF con todos los detalles. Cualquier duda, estoy a tu disposición. ¡Gracias!`
  );
  const url = tel ? `https://wa.me/${tel.replace('+','')}?text=${msg}` : `https://web.whatsapp.com/?text=${msg}`;
  window.open(url, '_blank');
}
function copiarPresupuesto(id) {
  const p = presupuestos.find(x => x.id === id);
  if(!p) return;
  const cfg = getConfig();
  const txt = `PRESUPUESTO ${p.numero || ''} — ${cfg.empresa || 'JM SERVICIOS INTEGRALES'}\nCliente: ${p.cliente}\nTrabajo: ${p.desc}\nTotal: ${fmt(p.total)} IVA incluido\nValidez: ${p.validez} días\nCondiciones: ${p.condiciones}`;
  navigator.clipboard?.writeText(txt);
  toast('Texto copiado al portapapeles ✓');
}

// ===================== CLIENTES =====================
function renderClientes() {
  const map = {};
  [...movimientos, ...presupuestos].forEach(x => {
    if(!x.cliente) return;
    const k = x.cliente.toLowerCase();
    map[k] = map[k] || {cliente: x.cliente, telefono: x.telefono || '', direccion: x.direccion || '', total: 0, n: 0};
    map[k].total += x.importe || x.total || 0;
    map[k].n++;
  });
  const arr = Object.values(map);
  document.getElementById('lista-clientes').innerHTML = arr.length ? arr.map(c => {
    const tel = (c.telefono || '').replace(/\s+/g, '').replace(/^0/, '');
    const telWA = tel ? (tel.startsWith('+') ? tel.replace('+','') : '34' + tel) : '';
    const waBtn = telWA ? `<a href="https://wa.me/${telWA}" target="_blank" style="background:#25D366;border:0;border-radius:50%;width:36px;height:36px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;text-decoration:none;flex-shrink:0" title="Abrir WhatsApp">📲</a>` : '';
    return `<div class="item-row"><div class="item-info"><div class="item-title">${c.cliente}</div><div class="item-sub">${c.telefono || 'Sin teléfono'} · ${c.direccion || 'Sin dirección'} · ${c.n} trabajos</div></div><div style="display:flex;align-items:center;gap:8px">${waBtn}<div class="item-amount">${fmt(c.total)}</div></div></div>`;
  }).join('') : '<div class="empty"><div class="empty-icon">👤</div><p>Aún no hay clientes guardados</p></div>';
}

// ===================== DASHBOARD =====================
function renderDashboard() {
  const ahora = new Date(), mes = ahora.getMonth(), anyo = ahora.getFullYear();
  const movMes = movimientos.filter(m => { const d = new Date(m.fecha + 'T00:00:00'); return d.getMonth() === mes && d.getFullYear() === anyo; });
  const ing = movMes.filter(m => m.tipo === 'ingreso').reduce((s,m) => s + m.importe, 0);
  const gas = movMes.filter(m => m.tipo === 'gasto').reduce((s,m) => s + m.importe, 0);
  const ben = ing - gas;
  const margen = ing > 0 ? Math.max(0, Math.min(100, ben / ing * 100)) : 0;
  const pend = presupuestos.filter(p => p.estado === 'pendiente').reduce((s,p) => s + p.total, 0);
  document.getElementById('stat-ingresos').textContent = fmt(ing);
  document.getElementById('stat-gastos').textContent = fmt(gas);
  document.getElementById('stat-beneficio').textContent = fmt(ben);
  document.getElementById('stat-beneficio').className = 'stat-value ' + (ben >= 0 ? 'verde' : 'rojo');
  document.getElementById('stat-pendiente').textContent = fmt(pend);
  document.getElementById('dash-ing').textContent = fmt(ing);
  document.getElementById('dash-gas').textContent = fmt(gas);
  document.getElementById('dash-ben').textContent = fmt(ben);
  document.getElementById('dash-iva').textContent = fmt(ing * .21);
  document.getElementById('dash-irpf').textContent = fmt(Math.max(0, ben) * .20);
  document.getElementById('dash-bar').style.width = margen + '%';
  document.getElementById('dash-margen-pct').textContent = 'Margen ' + margen.toFixed(0) + '%';
  document.getElementById('dash-mes').textContent = meses[mes] + ' ' + anyo;

  // Alertas presupuestos próximos a vencer
  const hoy = new Date();
  const pronto = presupuestos.filter(p => {
    if(p.estado !== 'pendiente') return false;
    const fechaPres = new Date(p.fecha + 'T00:00:00');
    const vence = new Date(fechaPres);
    vence.setDate(vence.getDate() + (p.validez || 15));
    const diasRestantes = Math.ceil((vence - hoy) / (1000 * 60 * 60 * 24));
    p._diasRestantes = diasRestantes;
    return diasRestantes >= 0 && diasRestantes <= 3;
  });
  const alertasEl = document.getElementById('dash-alertas');
  if(pronto.length) {
    alertasEl.innerHTML = `<div class="card" style="border-color:rgba(240,192,64,.4);background:rgba(240,192,64,.05)">
      <div class="card-title" style="color:var(--amarillo)">⚠️ Presupuestos a punto de vencer</div>
      ${pronto.map(p => `<div class="item-row"><div class="item-info"><div class="item-title">${escapeHTML(p.cliente)}</div><div class="item-sub">${p.numero || ''} · Vence en ${p._diasRestantes} día${p._diasRestantes === 1 ? '' : 's'}</div></div><div class="item-amount azul">${fmt(p.total)}</div></div>`).join('')}
    </div>`;
  } else {
    alertasEl.innerHTML = '';
  }

  const ult = movimientos.slice(0, 4);
  document.getElementById('dash-movimientos').innerHTML = ult.length ? ult.map(m => `<div class="item-row"><div class="item-info"><div class="item-title">${m.concepto}</div><div class="item-sub">${fmtFecha(m.fecha)}</div></div><div class="item-amount ${m.tipo === 'ingreso' ? 'verde' : 'rojo'}">${m.tipo === 'ingreso' ? '+' : '-'}${fmt(m.importe)}</div></div>`).join('') : '<div class="empty"><div class="empty-icon">📭</div><p>Sin movimientos aún</p></div>';
  const pen = presupuestos.filter(p => p.estado === 'pendiente').slice(0, 4);
  document.getElementById('dash-pendientes').innerHTML = pen.length ? pen.map(p => `<div class="item-row"><div class="item-info"><div class="item-title">${p.numero ? '<span class="num-badge">' + p.numero + '</span> ' : ''}${escapeHTML(p.cliente)}</div><div class="item-sub">${p.desc || 'Presupuesto'} · ${fmtFecha(p.fecha)}</div></div><div class="item-amount azul">${fmt(p.total)}</div></div>`).join('') : '<div class="empty"><div class="empty-icon">📄</div><p>Sin pendientes</p></div>';
}

// ===================== PRECIOS =====================
function renderPrecios() {
  document.getElementById('grid-precios').innerHTML = PRECIOS_REF.map(p => `<div class="precio-ref-item" onclick="usarPrecio('${p.nombre.replaceAll("'", '')}')"><div class="nombre">${p.nombre}</div><div class="rango">${p.rango}</div><div class="unit">${p.unit}</div></div>`).join('');
}
function usarPrecio(nombre) {
  showSection('presupuestos'); openPresModal();
  setTimeout(() => { const first = document.querySelector('#partidas-container .partida-row input'); if(first) first.value = nombre; }, 60);
}
function calcPrecio() {
  const h = parseFloat(document.getElementById('calc-horas').value) || 0;
  const t = parseFloat(document.getElementById('calc-tarifa').value) || 0;
  const m = parseFloat(document.getElementById('calc-mat').value) || 0;
  const mg = parseFloat(document.getElementById('calc-margen').value) || 0;
  const d = parseFloat(document.getElementById('calc-desp').value) || 0;
  const mo = h * t, mat = m * (1 + mg / 100), total = mo + mat + d;
  document.getElementById('calc-mo').textContent = fmt(mo);
  document.getElementById('calc-mat-r').textContent = fmt(mat);
  document.getElementById('calc-desp-r').textContent = fmt(d);
  document.getElementById('calc-total').textContent = fmt(total);
}

// ===================== ARCHIVOS / EXPORT =====================
function descargarArchivo(nombre, contenido, tipo) {
  const blob = new Blob([contenido], {type: tipo});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = nombre; a.click();
  URL.revokeObjectURL(url);
}
function registrarExport(tipo) {
  historialExport.unshift({tipo, fecha: new Date().toISOString()});
  historialExport = historialExport.slice(0, 30);
  localStorage.setItem('jm_historial_export', JSON.stringify(historialExport));
}
function exportarJSON() {
  const fecha = today();
  descargarArchivo(`JM_Servicios_backup_${fecha}.json`, JSON.stringify({version:'2.1', exportado: new Date().toISOString(), empresa:'JM Servicios Integrales', movimientos, presupuestos, historialExport}, null, 2), 'application/json');
  registrarExport('Copia de seguridad JSON'); renderHistorialArchivos();
}
function exportarCSV(tipo) {
  const fecha = today();
  let csv = '';
  if(tipo === 'movimientos') {
    csv = 'Fecha;Tipo;Concepto;Cliente;Telefono;Direccion;Categoria;Importe\n' + movimientos.map(m => `${m.fecha};${m.tipo};${clean(m.concepto)};${clean(m.cliente)};${clean(m.telefono)};${clean(m.direccion)};${clean(m.categoria)};${m.importe.toFixed(2).replace('.',',')}`).join('\n');
    descargarArchivo(`JM_Ingresos_Gastos_${fecha}.csv`, '\uFEFF' + csv, 'text/csv;charset=utf-8');
    registrarExport('Ingresos/Gastos CSV');
  } else {
    csv = 'Numero;Fecha;Cliente;Telefono;Direccion;Descripcion;Estado;Base;IVA;Total\n' + presupuestos.map(p => `${p.numero||''};${p.fecha};${clean(p.cliente)};${clean(p.telefono)};${clean(p.direccion)};${clean(p.desc)};${p.estado};${(p.base||p.subtotal||0).toFixed(2).replace('.',',')};${(p.iva||0).toFixed(2).replace('.',',')};${(p.total||0).toFixed(2).replace('.',',')}`).join('\n');
    descargarArchivo(`JM_Presupuestos_${fecha}.csv`, '\uFEFF' + csv, 'text/csv;charset=utf-8');
    registrarExport('Presupuestos CSV');
  }
  renderHistorialArchivos();
}
function exportarInforme() {
  const mes = parseInt(document.getElementById('informe-mes').value);
  const anyo = parseInt(document.getElementById('informe-anyo').value);
  const movMes = movimientos.filter(m => { const d = new Date(m.fecha + 'T00:00:00'); return d.getMonth() === mes && d.getFullYear() === anyo; });
  const ingresos = movMes.filter(m => m.tipo === 'ingreso');
  const gastos = movMes.filter(m => m.tipo === 'gasto');
  const ti = ingresos.reduce((s,m) => s + m.importe, 0);
  const tg = gastos.reduce((s,m) => s + m.importe, 0);
  const ben = ti - tg;
  let txt = `INFORME MENSUAL — JM SERVICIOS INTEGRALES\nPeriodo: ${meses[mes]} ${anyo}\nGenerado: ${new Date().toLocaleString('es-ES')}\n==================================================\n\nINGRESOS\n------------------------------\n`;
  txt += ingresos.length ? ingresos.map(m => `${m.fecha} | ${m.concepto} | ${m.cliente || ''} | ${m.importe.toFixed(2)} EUR`).join('\n') : 'Sin ingresos';
  txt += `\nTOTAL INGRESOS: ${ti.toFixed(2)} EUR\nIVA ESTIMADO 21%: ${(ti*.21).toFixed(2)} EUR\n\nGASTOS\n------------------------------\n`;
  txt += gastos.length ? gastos.map(m => `${m.fecha} | ${m.concepto} | ${m.categoria || ''} | ${m.importe.toFixed(2)} EUR`).join('\n') : 'Sin gastos';
  txt += `\nTOTAL GASTOS: ${tg.toFixed(2)} EUR\n\nBENEFICIO NETO: ${ben.toFixed(2)} EUR\nIRPF ORIENTATIVO 20%: ${(Math.max(0,ben)*.2).toFixed(2)} EUR\n`;
  descargarArchivo(`JM_Informe_${meses[mes]}_${anyo}.txt`, txt, 'text/plain;charset=utf-8');
  registrarExport(`Informe mensual ${meses[mes]} ${anyo}`);
  renderHistorialArchivos();
}
function restaurarJSON(input) {
  const file = input.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = e => {
    try {
      const datos = JSON.parse(e.target.result);
      if(!datos.movimientos || !datos.presupuestos) throw Error('Formato incorrecto');
      if(!confirm('¿Restaurar copia? Se reemplazarán los datos actuales.')) return;
      movimientos = datos.movimientos;
      presupuestos = datos.presupuestos;
      historialExport = datos.historialExport || historialExport;
      save();
      localStorage.setItem('jm_historial_export', JSON.stringify(historialExport));
      registrarExport('Restauración de copia');
      renderDashboard(); renderHistorialArchivos();
      toast('Datos restaurados correctamente ✓');
    } catch(err) { alert('Archivo no válido'); }
  };
  reader.readAsText(file);
  input.value = '';
}
function renderHistorialArchivos() {
  const el = document.getElementById('historial-archivos');
  el.innerHTML = historialExport.length ? historialExport.map(h => `<div class="item-row"><div class="item-info"><div class="item-title">${h.tipo}</div><div class="item-sub">${new Date(h.fecha).toLocaleString('es-ES')}</div></div><span class="badge badge-verde">Exportado</span></div>`).join('') : '<div class="empty"><div class="empty-icon">📁</div><p>Sin exportaciones aún</p></div>';
}
function borrarTodo() {
  if(!confirm('¿Seguro que quieres borrar TODOS los datos? Esta acción no se puede deshacer.')) return;
  movimientos = []; presupuestos = []; historialExport = [];
  save();
  localStorage.removeItem('jm_historial_export');
  renderDashboard(); renderMovimientos(); renderPresupuestos(); renderClientes();
  toast('Todos los datos eliminados');
}

// ===================== INIT =====================
function init() {
  const sel = document.getElementById('informe-mes');
  sel.innerHTML = meses.map((m,i) => `<option value="${i}">${m}</option>`).join('');
  sel.value = new Date().getMonth();
  document.getElementById('informe-anyo').value = new Date().getFullYear();
  loadConfig();
  renderDashboard();
  renderPrecios();
  calcPrecio();
}
document.querySelectorAll('.modal-overlay').forEach(o => o.addEventListener('click', e => { if(e.target === o) o.classList.remove('open'); }));
init();
</script>
</body>
</html>
